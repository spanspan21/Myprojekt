<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ rules: the WebUntis password (plaintext prefs) must never leave
     the device via Google cloud backup. Device-to-device transfer keeps it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="untis.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
