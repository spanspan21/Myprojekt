<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Sovereign Seal v3: coin-like hairline ring with a crown jewel at 12,
         one substantial rounded J. No clutter — the mark IS the luxury. -->

    <!-- seal ring -->
    <path
        android:pathData="M 54 22 A 32 32 0 1 1 53.99 22 Z"
        android:strokeColor="#66D4B579"
        android:strokeWidth="2"
        android:fillColor="#00000000" />

    <!-- crown jewel, 12 o'clock -->
    <path
        android:fillColor="#F4E6BE"
        android:pathData="M 54 22 m -2.6 0 a 2.6 2.6 0 1 1 5.2 0 a 2.6 2.6 0 1 1 -5.2 0" />

    <!-- the J — chunky, soft terminals, champagne light falling top→bottom -->
    <path
        android:pathData="M 61.5 34 L 61.5 56.5 A 13.5 13.5 0 0 1 34.5 56.5 L 34.5 52.5"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="27"
                android:endX="54" android:endY="78">
                <item android:offset="0.0" android:color="#F2E2B6" />
                <item android:offset="0.5" android:color="#D4B579" />
                <item android:offset="1.0" android:color="#A07B47" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
